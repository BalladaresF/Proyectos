# Test 4: Verificar versión de Chrome
print("\n4. Verificando Chrome...")
try:
    if sys.platform.startswith('win'):
        import winreg
        # Intentar encontrar Chrome en el registro de Windows
        chrome_paths = [
            r"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\chrome.exe",
            r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Google Chrome"
        ]
        
        chrome_found = False
        for path in chrome_paths:
            try:
                key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, path)
                chrome_found = True
                print("   ✅ Chrome instalado (detectado en registro)")
                break
            except:
                continue
        
        if not chrome_found:
            print("   ❌ Chrome no detectado en registro")
    else:
        print("   ℹ️  Detección de Chrome no implementada para este SO")
        
