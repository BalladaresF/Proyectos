# Test 3: Verificar ChromeDriver sin iniciarlo
print("\n3. Buscando ChromeDriver...")
possible_paths = [
    # Windows
    r"C:\Users\{}\Downloads\chromedriver.exe".format(os.getenv('USERNAME', 'Usuario')),
    r"C:\Users\{}\Downloads\chromedriver".format(os.getenv('USERNAME', 'Usuario')),
    "./chromedriver.exe",
    "chromedriver.exe",
    # Mac/Linux  
    os.path.expanduser("~/Downloads/chromedriver"),
    "./chromedriver",
    "chromedriver"
]

chromedriver_found = []
for path in possible_paths:
    if os.path.exists(path):
        file_size = os.path.getsize(path)
        print(f"   ✅ ENCONTRADO: {path} (tamaño: {file_size} bytes)")
        chromedriver_found.append(path)
    else:
        print(f"   ❌ No existe: {path}")

if not chromedriver_found:
    print("\n   ⚠️  ChromeDriver NO encontrado en ubicaciones comunes")
    print("   Por favor descárgalo desde: https://chromedriver.chromium.org/")
else:
